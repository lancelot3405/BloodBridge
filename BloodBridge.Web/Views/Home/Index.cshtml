@{
    ViewData["Title"] = "Home";
}
<div class="p-5 mb-4 bg-white rounded-4 shadow-sm text-center">
    <h1 class="display-5 fw-bold text-danger">BloodBridge</h1>
    <p class="lead">Connect hospitals, requesters, and available blood donors quickly.</p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-danger btn-lg me-2" asp-controller="Auth" asp-action="Register">Get started</a>
        <a class="btn btn-outline-danger btn-lg" asp-controller="Auth" asp-action="Login">Log in</a>
    }
</div>
