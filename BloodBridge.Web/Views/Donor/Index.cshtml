@model DonorDashboardViewModel
@{
    ViewData["Title"] = "Donor dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Donor dashboard</h1><p class="text-muted mb-0">Help patients by keeping your availability up to date.</p></div><a class="btn btn-outline-danger" asp-action="Profile">Manage profile</a></div>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Profile is not null) { <div class="card border-0 shadow-sm mb-4"><div class="card-body d-flex flex-wrap justify-content-between align-items-center"><div><h5 class="mb-1">Welcome, @Model.Profile.Name</h5><span>@Model.Profile.BloodGroup · @Model.Profile.Location</span></div><span class="badge @(Model.Profile.IsAvailable ? "bg-success" : "bg-secondary")">@(Model.Profile.IsAvailable ? "Available" : "Unavailable")</span></div></div> }
<div class="card border-0 shadow-sm"><div class="card-body"><h5>Incoming compatible requests</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Blood group</th><th>Urgency</th><th>Units</th><th>Required date</th><th></th></tr></thead><tbody>@foreach (var request in Model.Requests) { <tr><td>@request.BloodGroup</td><td>@request.Urgency</td><td>@request.UnitsRequired</td><td>@request.RequiredDate.ToString("dd MMM yyyy")</td><td><form asp-action="Accept" method="post"><input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="donorId" value="@Model.Profile?.Id" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger">Accept request</button></form></td></tr> } @if (Model.Requests.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No matching pending requests right now.</td></tr> }</tbody></table></div></div></div>
