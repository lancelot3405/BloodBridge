<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BloodBridge</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">BloodBridge</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Requester"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Requester" asp-action="Index">My Requests</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Requester" asp-action="Create">Create Request</a></li>
                    }
                    @if (User.IsInRole("Donor"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Donor" asp-action="Index">Donor Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donor" asp-action="Impact">My Impact</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donor" asp-action="Profile">My Profile</a></li>
                    }
                    @if (User.IsInRole("Hospital"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Hospital" asp-action="Index">Hospital Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Hospital" asp-action="Profile">My Profile</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">Admin dashboard</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button id="notificationBell" class="btn btn-outline-light btn-sm position-relative" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                <span aria-hidden="true">🔔</span><span id="notificationCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark d-none">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-2 notification-menu" aria-labelledby="notificationBell">
                                <h6 class="dropdown-header">Notifications</h6>
                                <div id="notificationList" class="small text-muted px-2 py-2">Loading...</div>
                            </div>
                            @Html.AntiForgeryToken()
                        </div>
                        <span class="text-white small">@User.Identity.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Log in</a>
                        <a class="btn btn-light btn-sm text-danger" asp-controller="Auth" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
