@model HospitalDashboardViewModel
@{
    ViewData["Title"] = "Hospital dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Hospital dashboard</h1><p class="text-muted mb-0">Manage requests assigned to @Model.Profile?.HospitalName.</p></div><a class="btn btn-outline-danger" asp-action="Profile">Manage profile</a></div>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
<div class="card border-0 shadow-sm"><div class="card-body"><h5>Requests</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Blood group</th><th>Urgency</th><th>Units</th><th>Status</th><th>Workflow</th></tr></thead><tbody>@foreach (var request in Model.Requests) { <tr><td>@request.BloodGroup</td><td>@request.Urgency</td><td>@request.UnitsRequired</td><td><span class="badge status-badge">@request.Status</span></td><td><div class="d-flex gap-2">@if (request.Status.Equals("DONOR ACCEPTED", StringComparison.OrdinalIgnoreCase)) { <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="status" value="DONATION COMPLETED" /><button class="btn btn-sm btn-warning">Donation completed</button></form> } @if (request.Status.Equals("DONATION COMPLETED", StringComparison.OrdinalIgnoreCase)) { <form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="status" value="FULFILLED" /><button class="btn btn-sm btn-success">Mark fulfilled</button></form> }</div></td></tr> } @if (Model.Requests.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No requests assigned to this hospital.</td></tr> }</tbody></table></div></div></div>
