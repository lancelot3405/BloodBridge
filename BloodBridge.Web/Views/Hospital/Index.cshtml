@using System.Text.Json
@model HospitalDashboardViewModel
@{
    ViewData["Title"] = "Hospital dashboard";
    var inventory = Model.Inventory;
    var groups = inventory.Forecasts
        .Select(item => item.BloodGroup)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(item => item)
        .ToList();
    var defaultGroup = groups.Contains("A+") ? "A+" : groups.FirstOrDefault() ?? "A+";
    var forecastJson = JsonSerializer.Serialize(inventory.Forecasts.Select(item => new
    {
        group = item.BloodGroup,
        date = item.Date.ToString("yyyy-MM-dd"),
        demand = item.PredictedDemand
    }));
    var highRiskGroups = inventory.Forecasts
        .Where(item => item.HighShortageRisk)
        .GroupBy(item => item.BloodGroup)
        .Select(group => new
        {
            BloodGroup = group.Key,
            PeakDemand = group.Max(item => item.PredictedDemand),
            VirtualInventory = group.First().VirtualInventory
        })
        .OrderBy(item => item.BloodGroup)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2">Hospital dashboard</h1>
        <p class="text-muted mb-0">Manage requests assigned to @Model.Profile?.HospitalName.</p>
    </div>
    <a class="btn btn-outline-danger" asp-action="Profile">Manage profile</a>
</div>

@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">Blood demand forecast</h2>
                <p class="text-muted small mb-0">Predicted demand for the next seven days.</p>
            </div>
            @if (groups.Count > 0)
            {
                <label class="d-flex align-items-center gap-2 small">
                    <span>Blood group</span>
                    <select id="forecastGroup" class="form-select form-select-sm" style="width: 110px;">
                        @foreach (var group in groups)
                        {
                            <option value="@group" selected="@(group == defaultGroup)">@group</option>
                        }
                    </select>
                </label>
            }
        </div>

        @if (inventory.Error is not null)
        {
            <div class="alert alert-warning mb-0">@inventory.Error</div>
        }
        else if (inventory.Forecasts.Count == 0)
        {
            <div class="alert alert-info mb-0">No forecast is available yet.</div>
        }
        else
        {
            <div style="height: 320px;">
                <canvas id="demandChart" aria-label="Seven day blood demand forecast"></canvas>
            </div>
            <p class="text-muted small mt-3 mb-0">@inventory.VirtualInventoryNote</p>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Shortage risk alerts</h2>
        @if (highRiskGroups.Count == 0)
        {
            <div class="alert alert-success mb-0">No blood groups are currently above the virtual inventory threshold.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var risk in highRiskGroups)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="alert alert-danger h-100 mb-0">
                            <div class="fw-bold">High Shortage Risk: @risk.BloodGroup</div>
                            <div class="small mt-2">Peak predicted demand: @risk.PeakDemand.ToString("0.##")</div>
                            <div class="small">Virtual inventory: @risk.VirtualInventory</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Requests</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Blood group</th><th>Urgency</th><th>Units</th><th>Status</th><th>Workflow</th></tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.BloodGroup</td>
                        <td>@request.Urgency</td>
                        <td>@request.UnitsRequired</td>
                        <td><span class="badge status-badge">@request.Status</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                @if (request.Status.Equals("DONOR ACCEPTED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="status" value="DONATION COMPLETED" />
                                        <button class="btn btn-sm btn-warning">Donation completed</button>
                                    </form>
                                }
                                @if (request.Status.Equals("DONATION COMPLETED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <input type="hidden" name="status" value="FULFILLED" />
                                        <button class="btn btn-sm btn-success">Mark fulfilled</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Requests.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No requests assigned to this hospital.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (inventory.Forecasts.Count > 0)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Draw the selected blood group's seven-day forecast with the small Chart.js CDN library.
        const forecastRows = @Html.Raw(forecastJson);
        const groupSelect = document.getElementById('forecastGroup');
        let demandChart;

        function drawForecastChart() {
            const selectedGroup = groupSelect.value;
            const rows = forecastRows.filter(row => row.group === selectedGroup);
            const canvas = document.getElementById('demandChart');

            if (demandChart) {
                demandChart.destroy();
            }

            demandChart = new Chart(canvas, {
                type: 'line',
                data: {
                    labels: rows.map(row => row.date),
                    datasets: [{
                        label: selectedGroup + ' predicted demand',
                        data: rows.map(row => row.demand),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.12)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        groupSelect.addEventListener('change', drawForecastChart);
        drawForecastChart();
    </script>
}
