@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Admin dashboard</h1><p class="text-muted mb-0">Platform overview and account management.</p></div></div>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm stat-card"><div class="card-body"><div class="text-muted">Total donors</div><div class="display-6 fw-bold text-danger">@Model.Stats.TotalDonors</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm stat-card"><div class="card-body"><div class="text-muted">Active requests</div><div class="display-6 fw-bold text-danger">@Model.Stats.ActiveBloodRequests</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm stat-card"><div class="card-body"><div class="text-muted">Fulfilled requests</div><div class="display-6 fw-bold text-success">@Model.Stats.FulfilledRequests</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm stat-card"><div class="card-body"><div class="text-muted">Hospitals</div><div class="display-6 fw-bold text-danger">@Model.Stats.TotalHospitals</div></div></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h5>Requests by blood group</h5>@foreach (var group in new[] { "O+", "A+", "B+", "AB+" }) { var value = Model.Stats.RequestsByBloodGroup.TryGetValue(group, out var count) ? count : 0; <div class="d-flex align-items-center gap-2 mb-3"><span class="group-label">@group</span><div class="progress flex-grow-1"><div class="progress-bar bg-danger" style="width:@(Math.Min(value * 10, 100))%">@value</div></div></div> }</div></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h5>Blood requests</h5><div class="table-responsive"><table class="table table-sm"><thead><tr><th>ID</th><th>Group</th><th>Hospital</th><th>Status</th></tr></thead><tbody>@foreach (var request in Model.Requests.OrderByDescending(item => item.CreatedAt).Take(10)) { <tr><td>#@request.Id</td><td>@request.BloodGroup</td><td>#@request.HospitalId</td><td><span class="badge status-badge">@request.Status</span></td></tr> } @if (Model.Requests.Count == 0) { <tr><td colspan="4" class="text-muted">No requests.</td></tr> }</tbody></table></div></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">User management</h5><form class="d-flex gap-2"><select name="role" class="form-select form-select-sm"><option value="">All roles</option><option>Donor</option><option>Requester</option><option>Hospital</option><option>Admin</option></select><select name="status" class="form-select form-select-sm"><option value="">All statuses</option><option>Verified</option><option>Suspended</option><option>Deactivated</option><option>Unverified</option></select><button class="btn btn-sm btn-outline-danger">Filter</button></form></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var user in Model.Users.Items) { <tr><td>@user.Email</td><td>@user.Role</td><td><span class="badge @(user.Status == "Verified" ? "bg-success" : user.Status == "Suspended" ? "bg-warning text-dark" : "bg-secondary")">@user.Status</span></td><td><div class="d-flex gap-2"><form asp-action="UpdateUserStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="status" value="verify" /><button class="btn btn-sm btn-outline-success">Verify</button></form><form asp-action="UpdateUserStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="status" value="@(user.Status == "Suspended" ? "activate" : "suspend")" /><button class="btn btn-sm btn-outline-warning">@(user.Status == "Suspended" ? "Activate" : "Suspend")</button></form><form asp-action="UpdateUserStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="status" value="deactivate" /><button class="btn btn-sm btn-outline-danger">Deactivate</button></form></div></td></tr> } @if (Model.Users.Items.Count == 0) { <tr><td colspan="4" class="text-muted">No users found.</td></tr> }</tbody></table></div></div></div>
