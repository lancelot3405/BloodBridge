@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-4">Create your BloodBridge account</h2>
                <form asp-action="Register" method="post" id="registrationForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">I am registering as</label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="Donor">Donor</option>
                            <option value="Requester">Requester</option>
                            <option value="Hospital">Hospital</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
                    </div>
                    <div id="donorFields" class="role-fields">
                        <h5 class="text-danger">Donor profile</h5>
                        <div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label">Name</label><input asp-for="Name" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="BloodGroup" class="form-label">Blood group</label><select asp-for="BloodGroup" class="form-select"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div></div>
                        <div class="row"><div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label">Location or coordinates</label><input asp-for="Location" class="form-control" placeholder="23.2599, 77.4126" /></div></div>
                        <div class="form-check mb-3"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label">I am currently available to donate</label></div>
                    </div>
                    <div id="requesterFields" class="role-fields d-none">
                        <h5 class="text-danger">Requester profile</h5>
                        <div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="ContactNumber" class="form-label">Contact number</label><input asp-for="ContactNumber" class="form-control" /></div>
                    </div>
                    <div id="hospitalFields" class="role-fields d-none">
                        <h5 class="text-danger">Hospital profile</h5>
                        <div class="mb-3"><label asp-for="HospitalName" class="form-label">Hospital name</label><input asp-for="HospitalName" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="Location" class="form-label">Location or coordinates</label><input asp-for="Location" class="form-control" placeholder="23.2599, 77.4126" /></div>
                        <div class="mb-3"><label asp-for="ContactInfo" class="form-label">Contact information</label><input asp-for="ContactInfo" class="form-control" /></div>
                    </div>
                    <button class="btn btn-danger">Create account</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const select = document.getElementById('roleSelect');
        const fields = { Donor: document.getElementById('donorFields'), Requester: document.getElementById('requesterFields'), Hospital: document.getElementById('hospitalFields') };
        function showRole() { Object.entries(fields).forEach(([role, x]) => { const active = role === select.value; x.classList.toggle('d-none', !active); x.querySelectorAll('input,select').forEach(input => input.disabled = !active); }); }
        select.addEventListener('change', showRole); showRole();
    </script>
}
