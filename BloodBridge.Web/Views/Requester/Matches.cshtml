@model IReadOnlyList<MatchViewModel>
@{
    ViewData["Title"] = "Donor matches";
}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Compatible donors</h1><p class="text-muted mb-0">Sorted from closest to furthest when coordinates are available.</p></div><a class="btn btn-outline-danger" asp-action="Index">Back to requests</a></div>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-3">@foreach (var match in Model) { <div class="col-md-6 col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h5>@match.Name</h5><span class="badge bg-success">@match.BloodGroup</span></div><p class="text-muted mb-2">@match.Location</p><p class="mb-0">@(match.DistanceKm.HasValue ? $"{match.DistanceKm:0.##} km away" : "Distance unavailable")</p>@if (match.SameLocationAsHospital) { <small class="text-success">Same location</small> }</div></div></div> } @if (Model.Count == 0) { <div class="col-12"><div class="alert alert-info">No compatible available donors were found.</div></div> }</div>
